# CipherLens — Environment Variables
# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored — never commit your actual secrets.

# ─── Security / JWT ──────────────────────────────────────────
# Secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-value

# ─── Encryption at Rest ──────────────────────────────────────
# Must be exactly 32 bytes/characters — used as the AES-256 key that
# encrypts each user's private RSA key before it's stored. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MASTER_KEY=change-me-to-a-32-byte-secret!!

# ─── Machine Learning ────────────────────────────────────────
# Hugging Face API token (free at https://huggingface.co/settings/tokens),
# used for the document classification model.
HF_TOKEN=hf_your_huggingface_token_here

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ─── Database (only needed if using PostgreSQL / docker-compose) ─
POSTGRES_USER=cipherlens
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=cipherlens
# DATABASE_URL is only used when running the backend directly (outside
# docker-compose, which builds it from the POSTGRES_* vars above).
# DATABASE_URL=sqlite:///./cipherlens.db
